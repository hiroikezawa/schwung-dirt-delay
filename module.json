{
  "id": "dirt-delay",
  "name": "Dirt Delay",
  "abbrev": "DIRT",
  "version": "0.5.1",
  "description": "Two dirty stereo delays in series with input gain, bass-boosted overdrive and bitcrush, level-matched mix (from a Daisy Versio patch)",
  "author": "Hiro Ikezawa",
  "dsp": "dirt-delay.so",
  "api_version": 2,
  "component_type": "audio_fx",
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "audio_in": true,
    "audio_out": true,
    "midi_in": false,
    "midi_out": false,
    "chain_params": [
      {
        "key": "mix",
        "name": "Mix",
        "short_name": "MIX",
        "type": "float",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "default": 0.5,
        "unit": "%",
        "display_format": "%.0f"
      },
      {
        "key": "drive",
        "name": "Drive",
        "short_name": "DRIVE",
        "type": "float",
        "min": 0.3,
        "max": 1,
        "step": 0.01,
        "default": 0.5,
        "unit": "%",
        "display_format": "%.0f"
      },
      {
        "key": "time",
        "name": "Time",
        "short_name": "TIME",
        "type": "float",
        "min": 0,
        "max": 250,
        "step": 1,
        "default": 125,
        "unit": "ms",
        "display_format": "%.0f"
      },
      {
        "key": "feedback",
        "name": "Feedback",
        "short_name": "FDBK",
        "type": "float",
        "min": 0,
        "max": 0.9,
        "step": 0.01,
        "default": 0.4,
        "unit": "%",
        "display_format": "%.0f"
      },
      {
        "key": "crush",
        "name": "Crush",
        "short_name": "CRUSH",
        "type": "float",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "default": 0.5,
        "unit": "%",
        "display_format": "%.0f"
      },
      {
        "key": "gain",
        "name": "Input Gain",
        "short_name": "GAIN",
        "type": "float",
        "min": 0,
        "max": 24,
        "step": 0.5,
        "default": 0,
        "unit": "dB",
        "display_format": "%.1f"
      },
      {
        "key": "fx1",
        "name": "FX 1",
        "short_name": "FX1",
        "type": "enum",
        "options": [
          "Off",
          "OD",
          "BC"
        ],
        "default": 0
      },
      {
        "key": "fx2",
        "name": "FX 2",
        "short_name": "FX2",
        "type": "enum",
        "options": [
          "Off",
          "OD",
          "BC"
        ],
        "default": 0
      }
    ],
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Dirt Delay",
          "knobs": [
            "mix",
            "drive",
            "time",
            "feedback",
            "crush",
            "gain",
            "fx1",
            "fx2"
          ],
          "params": [
            {
              "key": "mix"
            },
            {
              "key": "drive"
            },
            {
              "key": "time"
            },
            {
              "key": "feedback"
            },
            {
              "key": "crush"
            },
            {
              "key": "gain"
            },
            {
              "key": "fx1"
            },
            {
              "key": "fx2"
            }
          ]
        }
      }
    }
  }
}
